# Where the Vite dev server proxies /api and /socket.io (the Express server).
VITE_API_PROXY_TARGET=http://localhost:4000

# Optional: call the API on another origin instead of the proxy (production builds).
# The server's CLIENT_ORIGIN must then include this app's origin.
# VITE_API_URL=   (leave empty in production: /api is proxied by vercel.json)
# VITE_SOCKET_URL=https://temy-backend.onrender.com
